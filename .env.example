# ================= sheets2kdocs 配置 =================
# 复制为 .env 并填写。所有凭据只保存在服务端，不要提交到 git。

# --- 管理页面登录（必填） ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me
# 会话签名密钥，随机 64 位十六进制： python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# --- 服务地址（OAuth 回调需要） ---
# 对外访问地址，例如 http://192.168.1.10:8300 或 https://sync.example.com
BASE_URL=
# 服务监听端口（容器内/进程）
PORT=8300
# 数据目录（SQLite 数据库所在位置）
DATA_DIR=./data
# 时区（影响 cron 调度与日志时间）
TZ=Asia/Shanghai

# --- 金山文档接入（二选一） ---
# KDOCS_BACKEND=cli     免企业认证（推荐）：个人账号 Token，在管理页「Kdocs 连接」粘贴保存
# KDOCS_BACKEND=openapi 企业开放平台：需企业开发者认证，见 docs/KDOCS_SETUP.md
KDOCS_BACKEND=cli
# 首次部署可在这里预填个人 Token（之后以管理页保存的为准）；也可留空到管理页填
KDOCS_CLI_TOKEN=
# --- openapi 模式才需要 ---
KDOCS_APP_ID=
KDOCS_APP_KEY=
# 回调地址默认是 {BASE_URL}/auth/kdocs/callback，与开放平台后台登记的一致
# KDOCS_REDIRECT_URI=

# --- Google 侧凭据（可选） ---
# 读取公开分享的表格时无需任何凭据
# API Key 模式（表格需链接共享）：
GOOGLE_API_KEY=
# Service Account 模式（可读私有表格）：粘贴 service-account JSON 原文，或填文件路径
GOOGLE_SERVICE_ACCOUNT_JSON=
